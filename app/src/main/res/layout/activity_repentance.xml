<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/repentance_page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- 警示标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ 警示"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/repentance_warning_text"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- 提示语 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="你正在浏览的内容不讨神喜悦。\n这罪正在偷走你与神的亲密。"
            android:textSize="16sp"
            android:textColor="@color/repentance_text_primary"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="28dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:background="@color/repentance_divider"
            android:layout_marginBottom="28dp" />

        <!-- 经文 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/repentance_scripture_bg"
            android:padding="20dp"
            android:text="「你们要圣洁，因为我是圣洁的。」\n\n—— 彼得前书 1:16"
            android:textSize="17sp"
            android:textStyle="italic"
            android:textColor="@color/repentance_scripture_text"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/repentance_scripture_bg"
            android:padding="20dp"
            android:text="「务要抵挡魔鬼，魔鬼就必离开你们逃跑了。你们亲近神，神就必亲近你们。」\n\n—— 雅各书 4:7-8"
            android:textSize="17sp"
            android:textStyle="italic"
            android:textColor="@color/repentance_scripture_text"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="28dp" />

        <!-- 呼召 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="现在就是悔改的时刻。\n转离这罪，归向你的神。\n祂的恩典够你用的，\n祂的慈爱永不断绝。"
            android:textSize="16sp"
            android:textColor="@color/repentance_text_call"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <!-- 递进文案：由 RepentanceActivity 按 hitCount 动态设置。
             第 1-2 次隐藏；第 3-4 次显示「恳切呼召」；第 5+ 次显示「诚实对质」。 -->
        <TextView
            android:id="@+id/tv_progression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="italic"
            android:textColor="@color/repentance_progression_text"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- 确认按钮：我愿意悔改（突出、引导优先点击） -->
        <Button
            android:id="@+id/btn_repent"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="我愿意悔改归向神"
            android:textSize="19sp"
            android:textStyle="bold"
            android:backgroundTint="@color/repentance_btn_primary_bg"
            android:textColor="@color/repentance_btn_primary_text"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- 关闭按钮（弱化：小、淡，降低视觉权重，引导用户优先悔改） -->
        <Button
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="返回 BeHoly"
            android:textSize="13sp"
            android:backgroundTint="@color/repentance_btn_secondary_bg"
            android:textColor="@color/repentance_btn_secondary_text" />

    </LinearLayout>
</ScrollView>
