<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="0dp">

    <!-- 左侧类型色条（动态着色） -->
    <View
        android:id="@+id/v_left_bar"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:background="@color/beholy_bar_adult" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 第一行：仅日期（右上角类型徽标已移除） -->
        <TextView
            android:id="@+id/tv_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/beholy_text_secondary" />

        <!-- 心情区 -->
        <LinearLayout
            android:id="@+id/ll_mood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repentance_label_mood"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/beholy_text_secondary" />

            <LinearLayout
                android:id="@+id/ll_mood_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </LinearLayout>

        <!-- 途径区 -->
        <LinearLayout
            android:id="@+id/ll_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repentance_label_method"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/beholy_text_secondary" />

            <LinearLayout
                android:id="@+id/ll_method_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </LinearLayout>

        <!-- 反思摘要 -->
        <TextView
            android:id="@+id/tv_reflection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/beholy_text_primary"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- 以后避免摘要 -->
        <TextView
            android:id="@+id/tv_avoidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/beholy_accent"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>
</LinearLayout>
